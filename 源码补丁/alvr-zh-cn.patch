diff -ruN '--exclude=target' '--exclude=openvr' '--exclude=build.log' orig/ALVR-20.14.1/alvr/gui_common/src/i18n.rs src/ALVR-20.14.1/alvr/gui_common/src/i18n.rs
--- orig/ALVR-20.14.1/alvr/gui_common/src/i18n.rs	1970-01-01 08:00:00.000000000 +0800
+++ src/ALVR-20.14.1/alvr/gui_common/src/i18n.rs	2026-11-04 23:00:58.509543600 +0800
@@ -0,0 +1,34 @@
+//! Very small translation layer for the ALVR Chinese localization.
+//!
+//! The table is generated by `tools/gen_i18n.py` from `tools/zh_cn.tsv`.
+//! Lookup is exact-match on the English source string; unknown strings are
+//! returned unchanged so that logs, ids and file paths stay untouched.
+
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+mod i18n_data;
+
+fn table() -> &'static HashMap<&'static str, &'static str> {
+    static TABLE: OnceLock<HashMap<&'static str, &'static str>> = OnceLock::new();
+
+    TABLE.get_or_init(|| i18n_data::ENTRIES.iter().copied().collect())
+}
+
+/// Translate a UI string. Returns the input untouched when there is no entry.
+pub fn tr(text: &str) -> String {
+    table()
+        .get(text)
+        .map(|translated| (*translated).to_owned())
+        .unwrap_or_else(|| text.to_owned())
+}
+
+/// Translate a UI string, borrowing when there is no entry.
+pub fn tr_str(text: &str) -> &str {
+    table().get(text).copied().unwrap_or(text)
+}
+
+/// True if a translation exists for this exact string.
+pub fn has(text: &str) -> bool {
+    table().contains_key(text)
+}

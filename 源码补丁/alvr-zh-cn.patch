diff -ruN '--exclude=target' '--exclude=openvr' '--exclude=build.log' orig/ALVR-20.14.1/alvr/gui_common/src/fonts.rs src/ALVR-20.14.1/alvr/gui_common/src/fonts.rs
--- orig/ALVR-20.14.1/alvr/gui_common/src/fonts.rs	1970-01-01 08:00:00.000000000 +0800
+++ src/ALVR-20.14.1/alvr/gui_common/src/fonts.rs	2026-11-04 23:00:58.536152800 +0800
@@ -0,0 +1,65 @@
+//! CJK font loading. egui's bundled fonts have no Chinese glyphs, so a system
+//! font is pulled in as a fallback for both the proportional and mono families.
+
+use egui::{Context, FontData, FontDefinitions, FontFamily};
+use std::sync::Arc;
+
+const SYSTEM_FONT_CANDIDATES: &[&str] = &[
+    r"C:\Windows\Fonts\msyh.ttc",
+    r"C:\Windows\Fonts\msyhbd.ttc",
+    r"C:\Windows\Fonts\simhei.ttf",
+    r"C:\Windows\Fonts\Deng.ttf",
+    r"C:\Windows\Fonts\simsun.ttc",
+    "/System/Library/Fonts/PingFang.ttc",
+    "/System/Library/Fonts/STHeiti Medium.ttc",
+    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+    "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
+    "/usr/share/fonts/truetype/arphic/uming.ttc",
+];
+
+fn read_first_available() -> Option<Vec<u8>> {
+    // A font dropped next to the executable always wins, which makes it easy to
+    // swap in a nicer typeface without rebuilding.
+    if let Ok(exe) = std::env::current_exe() {
+        if let Some(dir) = exe.parent() {
+            for name in ["cjk.ttf", "cjk.otf", "cjk.ttc"] {
+                if let Ok(bytes) = std::fs::read(dir.join(name)) {
+                    return Some(bytes);
+                }
+            }
+        }
+    }
+
+    for path in SYSTEM_FONT_CANDIDATES {
+        if let Ok(bytes) = std::fs::read(path) {
+            return Some(bytes);
+        }
+    }
+
+    None
+}
+
+/// Registers a Chinese-capable font as a fallback. Safe to call more than once.
+pub fn install_cjk_fonts(ctx: &Context) {
+    let Some(bytes) = read_first_available() else {
+        return;
+    };
+
+    let mut fonts = FontDefinitions::default();
+
+    let mut font_data = FontData::from_owned(bytes);
+    font_data.index = 0;
+    fonts
+        .font_data
+        .insert("cjk_fallback".to_owned(), Arc::new(font_data));
+
+    for family in [FontFamily::Proportional, FontFamily::Monospace] {
+        fonts
+            .families
+            .entry(family)
+            .or_default()
+            .push("cjk_fallback".to_owned());
+    }
+
+    ctx.set_fonts(fonts);
+}

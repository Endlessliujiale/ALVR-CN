+
+/// The OpenVR driver receives the session path as a narrow C string built from a UTF-8
+/// `String`, and `std::ifstream` reinterprets those bytes using the ANSI code page. On a
+/// Chinese Windows (code page 936) any non-ASCII character in the install path makes the
+/// driver fail to open session.json, which crashes SteamVR as soon as a headset is used.
+fn non_ascii_install_path() -> Option<&'static str> {
+    use std::sync::OnceLock;
+
+    static CACHED: OnceLock<Option<String>> = OnceLock::new();
+
+    CACHED
+        .get_or_init(|| {
+            let exe = std::env::current_exe().ok()?;
+            let path = exe.to_string_lossy().to_string();
+
+            if path.is_ascii() {
+                None
+            } else {
+                Some(path)
+            }
+        })
+        .as_deref()
